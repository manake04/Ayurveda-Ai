# Copy to .env and fill in. Everything except GEMINI_API_KEY has a working default.

# --- Answer generation: gemini | ollama | none (none = answers quoted from sources) ---
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
# 0 = no "thinking" (fastest); -1 = let the model decide
GEMINI_THINKING_BUDGET=0
# Used when LLM_PROVIDER=ollama (run the model locally instead of calling Gemini)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_LLM_MODEL=qwen3:8b

# --- Embeddings: ollama (local) | gemini (hosted, e.g. for deployment) ---
# Changing the model rebuilds the FAISS index automatically on the next start.
# Re-tune CONFIDENCE_* with `python -m eval.run_eval` afterwards.
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=embeddinggemma
EMBEDDING_QUERY_PREFIX="task: search result | query: "
EMBEDDING_DOCUMENT_PREFIX="title: none | text: "
CONFIDENCE_HIGH=0.50
CONFIDENCE_ABSTAIN=0.30

# Qwen3-Embedding instead:
#   EMBEDDING_MODEL=qwen3-embedding:0.6b      (or qwen3-embedding:8b-q8_0 with a GPU; ~3.5 s/query on CPU)
#   EMBEDDING_QUERY_PREFIX="Instruct: Given a question about intellectual property or regulation of Ayurvedic products, retrieve the legal provisions that answer it\nQuery: "
#   EMBEDDING_DOCUMENT_PREFIX=
# Hosted Gemini embeddings (no prefixes needed; task types are set by the code):
#   EMBEDDING_PROVIDER=gemini
#   EMBEDDING_MODEL=gemini-embedding-001
#   EMBEDDING_QUERY_PREFIX=
#   EMBEDDING_DOCUMENT_PREFIX=

# --- Optional cross-encoder reranker (off when empty) ---
RERANKER_MODEL=
# RERANKER_MODEL=Xenova/ms-marco-MiniLM-L-6-v2

# --- HTTP ---
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
