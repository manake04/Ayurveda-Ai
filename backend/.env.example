# Copy to .env and fill in. Everything except GEMINI_API_KEY has a working default.

# --- Answer generation: gemini | ollama | none (none = answers quoted from sources) ---
LLM_PROVIDER=gemini
# Tried when the primary fails before writing anything (quota, network, bad key).
LLM_FALLBACK_PROVIDER=ollama
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
# 0 = thinking off (fastest); -1 = let the model decide
GEMINI_THINKING_BUDGET=0
# Local model via Ollama (thinking is always off for answers)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_LLM_MODEL=qwen3.5:latest
# Keep models loaded between requests; reloading an 8B model costs ~10 s
OLLAMA_KEEP_ALIVE=30m

# --- Embeddings: ollama (local) | gemini (hosted, e.g. for deployment) ---
# Changing the model rebuilds the FAISS index automatically on the next start.
# Re-tune CONFIDENCE_* with `make eval` afterwards.
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=qwen3-embedding:8b-q8_0
EMBEDDING_QUERY_PREFIX="Instruct: Given a question about intellectual property or regulation of Ayurvedic products, retrieve the legal provisions that answer it\nQuery: "
EMBEDDING_DOCUMENT_PREFIX=
CONFIDENCE_HIGH=0.72
CONFIDENCE_ABSTAIN=0.615

# Faster and more reliable abstention on CPU (see docs/ARCHITECTURE.md benchmarks):
#   EMBEDDING_MODEL=embeddinggemma
#   EMBEDDING_QUERY_PREFIX="task: search result | query: "
#   EMBEDDING_DOCUMENT_PREFIX="title: none | text: "
#   CONFIDENCE_HIGH=0.50
#   CONFIDENCE_ABSTAIN=0.30
# Hosted Gemini embeddings (no prefixes needed; task types are set by the code):
#   EMBEDDING_PROVIDER=gemini
#   EMBEDDING_MODEL=gemini-embedding-001
#   EMBEDDING_QUERY_PREFIX=
#   EMBEDDING_DOCUMENT_PREFIX=

# --- Optional cross-encoder reranker (off when empty; needs `pip install fastembed`) ---
RERANKER_MODEL=

# --- Privacy (DPDP) ---
# Audit events keep a hash + length of each question; set true to also keep the text.
AUDIT_STORE_QUERY_TEXT=false
AUDIT_RETENTION_DAYS=90

# --- Escalation to a human IP facilitator (all optional) ---
ESCALATION_NAME=
ESCALATION_EMAIL=
ESCALATION_URL=
# Each new ticket is POSTed here as JSON if set (helpdesk, Slack/Teams webhook...)
ESCALATION_WEBHOOK_URL=

# --- Bhashini translation for languages beyond English/Hindi (all three required) ---
BHASHINI_USER_ID=
BHASHINI_API_KEY=
BHASHINI_PIPELINE_ID=

# --- HTTP ---
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
