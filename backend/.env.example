# Copy this file to .env and fill in only what you have.
# The assistant runs fully offline/free with NONE of these set (extractive,
# citation-only answers). Adding a key upgrades answer quality; it never
# changes which sources are retrieved or cited.

# --- Optional LLM for grounded answer synthesis (pick at most one) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Optional multilingual delivery (Bhashini, National Language Translation Mission) ---
# Leave blank to keep the MVP's English-corpus + English/Hindi UI-string mode.
BHASHINI_API_KEY=
BHASHINI_USER_ID=
BHASHINI_PIPELINE_ID=

# --- App config ---
CORPUS_DIR=../corpus
INDEX_DIR=./data/index
AUDIT_LOG_PATH=./data/audit_log.jsonl
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# GRAPH_DIR: where the built knowledge graph (graph.json) is stored/loaded from.
# DENSE_DIR: where the optional dense embedding index is stored/loaded from, if you've
#   installed requirements-dense.txt and run scripts/build_dense_index.py. Leaving this
#   at its default is fine either way -- the backend only uses it if a dense index has
#   actually been built there.
GRAPH_DIR=./data/graph
DENSE_DIR=./data/dense

# Retrieval confidence thresholds (TF-IDF cosine similarity, 0-1) used for the
# confidence indicator and safe-abstention behaviour. These defaults were tuned
# empirically against backend/eval/eval_set.jsonl on this corpus -- re-tune with
# `python eval/run_eval.py` after materially growing the corpus.
CONFIDENCE_HIGH_THRESHOLD=0.14
CONFIDENCE_MEDIUM_THRESHOLD=0.085
